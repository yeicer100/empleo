# Copia este archivo como ".env" y pon tus datos reales.
# El archivo .env NUNCA se sube a GitHub (ya deberia estar en .gitignore).

DB_HOST=localhost
# Puerto de MySQL (por defecto 3306; cambialo si el tuyo es otro, ej. 3307)
